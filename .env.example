# Local Neon, or the VPS Postgres reached from the container.
# DATABASE_URL=postgresql+psycopg://hackm:replace_me@host.docker.internal:5432/hackm
# NEON_DATABASE_URL
# RESEND_API_KEY
# EMAIL_FROM

# Fill these from the Razorpay dashboard. Use test-mode keys first.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Required: webhooks are refused without it. In the Razorpay dashboard enable
# payment.captured, payment.failed, order.paid, refund.processed, refund.failed.

# Local app URLs used in reset, invite, and activation links.
PARTICIPANT_APP_URL=https://hackmatrix.codes
ADMIN_APP_URL=http://127.0.0.1:3001

# Generated locally if left empty. Do not commit real values.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Cache for admin aggregates and the public leaderboard. Optional: without it every read hits Postgres.
REDIS_URL=redis://redis:6379/0

# Connection pool per API process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Set to 0 to disable the in-process email retry loop (for example when running several workers).
EMAIL_OUTBOX_WORKER=1
