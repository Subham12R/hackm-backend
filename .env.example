# Local Neon, or the VPS Postgres reached from the container.
# DATABASE_URL=postgresql+psycopg://hackm:replace_me@host.docker.internal:5432/hackm
# NEON_DATABASE_URL
# RESEND_API_KEY
# EMAIL_FROM

# Fill these from the Razorpay dashboard. Use test-mode keys first.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Required: webhooks are refused without it. In the Razorpay dashboard enable
# payment.captured, payment.failed, order.paid, refund.processed, refund.failed.

# Local app URLs used in reset, invite, and activation links.
PARTICIPANT_APP_URL=https://hackmatrix.codes
ADMIN_APP_URL=http://127.0.0.1:3001

# Generated locally if left empty. Do not commit real values.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Cache for admin aggregates and the public leaderboard. Optional: without it every read hits Postgres.
REDIS_URL=redis://redis:6379/0

# Connection pool per API process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Set to 0 to disable the in-process email retry loop (for example when running several workers).
EMAIL_OUTBOX_WORKER=1
# Optional: image at the top of every email (defaults to PARTICIPANT_APP_URL/email/hackmatrix-26-banner.gif)
# EMAIL_BANNER_URL=

# Photo gallery (optional). Without S3_BUCKET the gallery is empty and uploads answer 503.
# Admins upload straight to the bucket (presigned POST on AWS, presigned PUT when S3_ENDPOINT_URL
# is set); the keys need PutObject, GetObject (for HEAD) and DeleteObject on gallery/*.
# S3_BUCKET=hackmatrix-gallery
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Public base for photo URLs, e.g. a CloudFront domain. Defaults to the bucket's S3 URL.
# Required for Cloudflare R2: the bucket's r2.dev URL or its custom domain.
# S3_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net
# Only for S3-compatible stores. Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com with S3_REGION=auto.
# S3_ENDPOINT_URL=
